# Copy to .env and fill in. Leave blank to use local stubs.

# --- Core ---
# SQLite path (relative to project root)
DATABASE_PATH=job_search.db

# --- LLM intent router (Anthropic / Claude) ---
# If ANTHROPIC_API_KEY is set, the Claude router is used.
# If blank, a no-key heuristic router is used (fully functional offline).
ANTHROPIC_API_KEY=
# Cheapest capable model; great for intent classification. Override if desired.
ANTHROPIC_MODEL=claude-haiku-4-5

# Token-saving guards
LLM_RATE_LIMIT_PER_MIN=30   # token-bucket cap; over-limit calls fall back offline
LLM_MAX_SMS_CHARS=480       # truncate inbound SMS before sending to the API

# --- Twilio ---
# Inbound webhook replies are TwiML (no creds needed). Auth token also validates
# inbound request signatures in production.
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=false
# Outbound SMS for scheduled reminders (Phase 2). Set ALL THREE to switch
# reminder delivery from LogSender to live Twilio. Requires A2P 10DLC approval.
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=          # your Twilio number, e.g. +14155551234

# --- Slack (primary transport) ---
# Bot token (xoxb-...) enables inbound replies AND outbound reminders over Slack
# (no A2P 10DLC needed — works immediately). When set, reminder delivery uses
# Slack instead of Twilio. Get it from your Slack app's "OAuth & Permissions".
SLACK_BOT_TOKEN=
# Signing secret from the Slack app's "Basic Information" page. When set, inbound
# Events API requests to /slack/events are signature-verified (recommended).
SLACK_SIGNING_SECRET=

# --- Apollo (Phase 3: recruiter discovery for OUTREACH) ---
# When set, "reach out to a recruiter at <company>" pulls contacts from Apollo
# and drafts an intro. When blank, the assistant says it needs a key — nothing
# else breaks (fully offline otherwise).
APOLLO_API_KEY=
# Guardrails — people api_search is free; org lookup costs credits (off by default).
APOLLO_MAX_RESULTS=3                  # contacts returned per new company discovery
APOLLO_MAX_DISCOVERIES_PER_DAY=5      # max new-company Apollo searches per UTC day
APOLLO_RATE_LIMIT_PER_MIN=3           # burst cap; over-limit skips gracefully
APOLLO_ORG_LOOKUP_ENABLED=false       # mixed_companies/search burns credits — keep false
APOLLO_MAX_ORG_SEARCHES_PER_DAY=3     # cap credit-consuming org lookups per UTC day
APOLLO_ORG_MISS_CACHE_DAYS=30         # don't re-spend credits when org has no domain

# Default follow-up window for a new application, in days
DEFAULT_FOLLOWUP_DAYS=7

# --- Job discovery (Phase 1) ---
# The background loop polls tracked company boards and Slack-alerts new matches.
# Free, no-auth ATS sources are on by default; paid sources are added later.
JOB_SOURCES_ENABLED=greenhouse,lever,ashby
JOB_POLL_SECONDS=600              # how often to poll tracked boards
JOB_RELEVANCE_THRESHOLD=0.6       # 0..1; a posting must score >= this to alert
JOB_MAX_SCORED_PER_TICK=40        # cap LLM-scored new postings per tick (token guard)
JOB_ALERT_USER=                   # Slack user id to alert; blank = each tracked user

# --- Job discovery: paid aggregator (Phase 3) ---
# A SerpApi-style Google Jobs search across the whole web, driven by your saved
# profile (roles + locations) — finds roles beyond the company boards you track.
# OFF by default: needs BOTH the enable flag AND a key, and is budget-capped per
# UTC day. Each search costs money, so caps + a rate limit guard against spend
# (mirrors the Apollo guards above).
AGGREGATOR_SEARCH_ENABLED=false       # master switch — off by default
AGGREGATOR_API_KEY=                   # SerpApi (or compatible) key; blank = disabled
AGGREGATOR_MAX_CALLS_PER_DAY=10       # daily billable-search budget (UTC day)
AGGREGATOR_RATE_LIMIT_PER_MIN=3       # burst cap; over-limit skips gracefully
AGGREGATOR_RESULTS_PER_CALL=20        # postings kept per search
AGGREGATOR_LOCATION=                  # optional location filter sent to the API
