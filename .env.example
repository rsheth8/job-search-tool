# Copy to .env and fill in. Leave blank to use local stubs.

# --- Core ---
DATABASE_PATH=job_search.db

# --- Claude (Anthropic) ---
# Setting ANTHROPIC_API_KEY turns on every paid path at once: job scoring,
# resume extraction, quiz polish, application-answer drafting, cover letters,
# resume tailoring, and Horizon's answers in the Ask tab. Blank = heuristics
# everywhere, fully functional offline.
# Intent *parsing* stays heuristic + on-device either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_RATE_LIMIT_PER_MIN=30
LLM_MAX_SMS_CHARS=480
# Per-user daily cap across every feature. 0 = off.
LLM_MAX_CALLS_PER_USER_PER_DAY=80
# Per-feature slices of that cap, so one feature can't spend the whole day and
# leave the others on heuristics. The cap above is still the hard ceiling.
# 0 = that feature is bounded only by the global cap.
LLM_CAP_CHAT=30
LLM_CAP_DISCOVERY=30
LLM_CAP_DRAFT=20
LLM_CAP_PARSE=8
LLM_CAP_QUIZ=8

# --- Sign in with Apple + in-app chat ---
APPLE_CLIENT_IDS=com.rahil.jobpilot
AUTH_SESSION_DAYS=90
# Invite-only Apple sign-in. Comma-separated emails. Empty = anyone (local only).
AUTH_ALLOWED_EMAILS=
# Production MUST be false so a blank APPLY_API_TOKEN is not an open door.
AUTH_FAIL_OPEN=true
# Mint sessions without Apple (tests / local only — never enable in production).
AUTH_ALLOW_DEV_LOGIN=false
AUTH_DEV_USER_ID=
# On first Apple (or dev) sign-in, fold this legacy user_id into the new account.
AUTH_LEGACY_USER_ID=

DEFAULT_FOLLOWUP_DAYS=7

# --- Job discovery ---
# Comma-separated: greenhouse,lever,ashby,workable,smartrecruiters,rss,directory,swelist,yc
JOB_SOURCES_ENABLED=greenhouse,lever,ashby,workable,smartrecruiters,rss,directory,swelist,yc
JOB_WIDE_RSS_ENABLED=true
# Extra We Work Remotely categories (wwr-design, wwr-product, wwr-sales, …) are
# selected from the job-search profile. Company catalog: data/company_catalog.json
# (names by field; only rows with ATS tokens are live-probed).
JOB_WIDE_RSS_FEEDS=hn-hiring,remoteok,weworkremotely,himalayas,remotive
JOB_WIDE_DIRECTORY_ENABLED=true
JOB_DIRECTORY_BOARDS_PER_TICK=32
JOB_DIRECTORY_MAX_JOBS_PER_BOARD=25
JOB_DIRECTORY_DATA_PATH=data/ats_boards.json
JOB_COMPANY_CATALOG_PATH=data/company_catalog.json
JOB_CATALOG_PROBE_ENABLED=true
JOB_CATALOG_PROBE_PER_TICK=6
JOB_VERIFY_APPLY_URLS=true
JOB_WIDE_SWELIST_ENABLED=true
JOB_SWELIST_LIST=summer2027,newgrad
JOB_SWELIST_MAX_AGE_DAYS=21
JOB_WIDE_YC_ENABLED=true
JOB_POLL_SECONDS=600
JOB_RELEVANCE_THRESHOLD=0.6
JOB_AUTO_QUEUE_THRESHOLD=0.0
JOB_MAX_SCORED_PER_TICK=60
JOB_ALERT_MODE=digest             # digest | instant | silent
JOB_DIGEST_TOP_N=5
JOB_ALERT_USER=

# --- Resume tailoring ---
# Local: ./resumes   Fly: /data/resumes
RESUME_TEX_DIR=./resumes
RESUME_TAILOR_ENABLED=true
TECTONIC_BIN=tectonic
COVER_LETTER_ENABLED=true

# --- Matching filters ---
GHOST_FILTER_ENABLED=true
ELIGIBILITY_FILTER_ENABLED=true
ELIGIBILITY_CANDIDATE_LEVEL=entry
ELIGIBILITY_FIELD_FILTER=true

# Personalized re-ranker (on in beta; no-op until you have apply/dismiss labels)
RERANKER_ENABLED=true
RERANKER_MIN_POSITIVE=5
RERANKER_MIN_NEGATIVE=5
RERANKER_OUTCOME_WEIGHTING=true

# --- Apply API (iOS uses Bearer session; token still useful for scripts) ---
APPLY_API_TOKEN=
APPLY_CORS_ORIGINS=*
APPLY_CORS_ORIGIN_REGEX=

# --- Push (APNs) ---
# Sandbox for Xcode debug builds; false for TestFlight.
PUSH_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.rahil.jobpilot
APNS_KEY_PATH=
APNS_USE_SANDBOX=true

# --- Observability / beta ---
SENTRY_DSN=
FEEDBACK_NOTIFY_USER=

# Optional. Raises GitHub API rate limits for profile import.
GITHUB_TOKEN=
